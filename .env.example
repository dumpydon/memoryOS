# Shared local development defaults. Copy this file to .env for the API.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Optional MCP public-host override. Render supplies RENDER_EXTERNAL_URL automatically.
# Set API_PUBLIC_ORIGIN to the API HTTPS origin when using a custom domain.
API_PUBLIC_ORIGIN=

# Database: the compose service exposes this URL on localhost.
DATABASE_URL=postgresql+psycopg://memoryos:memoryos@localhost:5432/memoryos
# Production: use Neon's ordinary PostgreSQL URL with sslmode=require.
# postgres:// and postgresql:// are normalized to the installed Psycopg driver.

# Keep this token local. REST and MCP use the same owner token in MVP mode.
OWNER_API_TOKEN=memoryos-local-token
# Production requires APP_ENV=production, a distinct secret OWNER_API_TOKEN,
# an external DATABASE_URL, and WEB_ORIGIN set to the exact deployed frontend origin.

# `demo` runs authored deterministic fixture providers and never makes paid LLM calls.
EXECUTION_MODE=demo
# Server-only key. Demo works without it; live requests fail clearly when absent.
# Select Live scope in Settings and enter OWNER_API_TOKEN to submit arbitrary input.
OPENAI_API_KEY=
# A model supporting Responses API structured outputs; configurable without code changes.
OPENAI_MODEL=gpt-4.1-mini
# All vectors remain 1536-dimensional. Changing model requires a compatible live scope.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEMO_EMBEDDING_MODEL=demo-fixture-v1
DEMO_EMBEDDING_DIMENSIONS=1536
PROVIDER_TIMEOUT_SECONDS=30
MAX_INTERACTION_CHARS=20000

# Next.js reads apps/web/.env.local or Vercel build settings, not this root file.
# A production build requires this public origin explicitly. Never expose owner/provider keys.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
