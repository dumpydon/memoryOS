# Shared local development defaults. Copy this file to .env for the API.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Database: the compose service exposes this URL on localhost.
DATABASE_URL=postgresql+psycopg://memoryos:memoryos@localhost:5432/memoryos

# Keep this token local. REST and MCP use the same owner token in MVP mode.
OWNER_API_TOKEN=memoryos-local-token

# `demo` runs authored deterministic fixture providers and never makes paid LLM calls.
EXECUTION_MODE=demo
# Server-only key. Demo works without it; live requests fail clearly when absent.
# Select Live scope in Settings and enter OWNER_API_TOKEN to submit arbitrary input.
OPENAI_API_KEY=
# A model supporting Responses API structured outputs; configurable without code changes.
OPENAI_MODEL=gpt-4.1-mini
# All vectors remain 1536-dimensional. Changing model requires a compatible live scope.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEMO_EMBEDDING_MODEL=demo-fixture-v1
DEMO_EMBEDDING_DIMENSIONS=1536
PROVIDER_TIMEOUT_SECONDS=30
MAX_INTERACTION_CHARS=20000

# Frontend build-time API origin. The browser never receives OWNER_API_TOKEN.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
