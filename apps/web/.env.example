# Browser-visible API origin. Do not put OWNER_API_TOKEN or OPENAI_API_KEY here.
# Copy to apps/web/.env.local for a local production build. Vercel must use the Render HTTPS origin.
# NEXT_PUBLIC_API_BASE_URL is required at build time; changing it requires rebuilding.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
